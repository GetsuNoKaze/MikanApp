diff --git a/transport/trusttunnel/client_conns_test.go b/transport/trusttunnel/client_conns_test.go
new file mode 100644
index 00000000..c8e7d362
--- /dev/null
+++ b/transport/trusttunnel/client_conns_test.go
@@ -0,0 +1,135 @@
+package trusttunnel
+
+import (
+	"context"
+	"io"
+	"log"
+	"net"
+	stdhttp "net/http"
+	"net/http/httptest"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/vmess"
+)
+
+type countingDialer struct {
+	dials atomic.Int64
+}
+
+func (d *countingDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	d.dials.Add(1)
+	var dialer net.Dialer
+	return dialer.DialContext(ctx, network, address)
+}
+
+func (d *countingDialer) ListenPacket(ctx context.Context, network, address string, rAddrPort netip.AddrPort) (net.PacketConn, error) {
+	var config net.ListenConfig
+	return config.ListenPacket(ctx, network, address)
+}
+
+// startConnectServer answers every CONNECT with 200 and keeps the stream open
+// until the client closes it.
+func startConnectServer(t *testing.T) *httptest.Server {
+	t.Helper()
+	server := httptest.NewUnstartedServer(stdhttp.HandlerFunc(func(writer stdhttp.ResponseWriter, request *stdhttp.Request) {
+		if request.Method != stdhttp.MethodConnect {
+			writer.WriteHeader(stdhttp.StatusMethodNotAllowed)
+			return
+		}
+		writer.WriteHeader(stdhttp.StatusOK)
+		writer.(stdhttp.Flusher).Flush()
+		_, _ = io.Copy(io.Discard, request.Body)
+	}))
+	server.EnableHTTP2 = true
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return server
+}
+
+func newCountingClient(t *testing.T, server *httptest.Server, maxConnections int) (*PoolClient, *countingDialer) {
+	t.Helper()
+	dialer := &countingDialer{}
+	client, err := NewPoolClient(context.Background(), ClientOptions{
+		Dialer:         dialer,
+		Server:         server.Listener.Addr().String(),
+		Username:       "user",
+		Password:       "password",
+		TLSConfig:      &vmess.TLSConfig{Host: "example.com", SkipCertVerify: true},
+		MaxConnections: maxConnections,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = client.Close() })
+	return client, dialer
+}
+
+func dialConcurrently(t *testing.T, client *PoolClient, n int) []net.Conn {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	conns := make([]net.Conn, n)
+	errs := make([]error, n)
+	var wg sync.WaitGroup
+	for i := range conns {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			conns[i], errs[i] = client.Dial(ctx, "example.org:443")
+		}(i)
+	}
+	wg.Wait()
+	for i, err := range errs {
+		if err != nil {
+			t.Fatalf("dial %d: %v", i, err)
+		}
+	}
+	t.Cleanup(func() {
+		for _, conn := range conns {
+			_ = conn.Close()
+		}
+	})
+	return conns
+}
+
+// One client must mean one TLS connection: concurrent streams on a cold
+// client wait for the first HTTP/2 session instead of each dialing their own.
+func TestClientConcurrentDialsShareConnection(t *testing.T) {
+	server := startConnectServer(t)
+	client, dialer := newCountingClient(t, server, 1)
+	dialConcurrently(t, client, 20)
+	if got := dialer.dials.Load(); got != 1 {
+		t.Fatalf("20 concurrent streams with max-connections 1 opened %d connections, want 1", got)
+	}
+}
+
+// After the server drops the connection the client must dial again rather
+// than wait forever for a slot held by the dead connection.
+func TestClientRedialsAfterConnectionLoss(t *testing.T) {
+	server := startConnectServer(t)
+	client, dialer := newCountingClient(t, server, 1)
+	dialConcurrently(t, client, 5)
+	server.CloseClientConnections()
+
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		conn, err := client.Dial(ctx, "example.org:443")
+		cancel()
+		if err == nil {
+			_ = conn.Close()
+			if dialer.dials.Load() >= 2 {
+				return
+			}
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("no new connection after loss: dials=%d, last error: %v", dialer.dials.Load(), err)
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}
diff --git a/transport/trusttunnel/client_dial_test.go b/transport/trusttunnel/client_dial_test.go
new file mode 100644
index 00000000..f9521dc9
--- /dev/null
+++ b/transport/trusttunnel/client_dial_test.go
@@ -0,0 +1,116 @@
+package trusttunnel
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/transport/vmess"
+)
+
+// silentFirstDialer sends the first dial to a listener that accepts TCP and
+// never answers the TLS handshake, and every later dial to the real server.
+type silentFirstDialer struct {
+	silent string
+	dials  atomic.Int64
+}
+
+func (d *silentFirstDialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	if d.dials.Add(1) == 1 {
+		address = d.silent
+	}
+	var dialer net.Dialer
+	return dialer.DialContext(ctx, network, address)
+}
+
+func (d *silentFirstDialer) ListenPacket(ctx context.Context, network, address string, rAddrPort netip.AddrPort) (net.PacketConn, error) {
+	var config net.ListenConfig
+	return config.ListenPacket(ctx, network, address)
+}
+
+// startSilentListener accepts connections and holds them open without
+// reading or writing, like a server that took TCP and stalled.
+func startSilentListener(t *testing.T) string {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var mu sync.Mutex
+	var conns []net.Conn
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			conns = append(conns, conn)
+			mu.Unlock()
+		}
+	}()
+	t.Cleanup(func() {
+		_ = listener.Close()
+		mu.Lock()
+		defer mu.Unlock()
+		for _, conn := range conns {
+			_ = conn.Close()
+		}
+	})
+	return listener.Addr().String()
+}
+
+func setDialTimeout(t *testing.T, timeout time.Duration) {
+	t.Helper()
+	old := sessionDialTimeout
+	sessionDialTimeout = timeout
+	t.Cleanup(func() { sessionDialTimeout = old })
+}
+
+// With one connection per client, every stream of a cold client waits for
+// the one dial. A server that accepts TCP and never finishes TLS must fail
+// that dial within the timeout and leave the slot free for a fresh one.
+func TestClientDialTimesOutOnSilentServer(t *testing.T) {
+	setDialTimeout(t, 300*time.Millisecond)
+	server := startConnectServer(t)
+	dialer := &silentFirstDialer{silent: startSilentListener(t)}
+	client, err := NewPoolClient(context.Background(), ClientOptions{
+		Dialer:         dialer,
+		Server:         server.Listener.Addr().String(),
+		Username:       "user",
+		Password:       "password",
+		TLSConfig:      &vmess.TLSConfig{Host: "example.com", SkipCertVerify: true},
+		MaxConnections: 1,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = client.Close() })
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	start := time.Now()
+	conn, err := client.Dial(ctx, "example.org:443")
+	cancel()
+	if err == nil {
+		_ = conn.Close()
+		t.Fatal("dial through a silent server succeeded")
+	}
+	if elapsed := time.Since(start); elapsed > 2*time.Second {
+		t.Fatalf("dial through a silent server failed after %v, want about the 300ms timeout", elapsed)
+	}
+
+	ctx, cancel = context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err = client.Dial(ctx, "example.org:443")
+	if err != nil {
+		t.Fatalf("dial after the timeout: %v (dials=%d)", err, dialer.dials.Load())
+	}
+	_ = conn.Close()
+	if got := dialer.dials.Load(); got != 2 {
+		t.Fatalf("dials = %d, want 2: the silent one and a fresh one", got)
+	}
+}
